# Copy this file to `.env` and change the values.

# true  = use the fake data in src/api/mock.js (no back end needed)
# false = call the real API
VITE_USE_MOCK=true

# Only used when VITE_USE_MOCK=false. No trailing slash.
# /api/v1 goes through the dev server's proxy to the back end on port 3000 (see vite.config.js).
VITE_API_URL=/api/v1
